# =============================================================================
# Art Res (home-swap-mvp) Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control - only .env.example
#
# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (Neon PostgreSQL - serverless)
# Get your connection string from: https://neon.tech
# Format: postgresql://user:password@host/database?sslmode=require
# Free tier: 100 CU-hours/month, 3GB storage
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://username:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# -----------------------------------------------------------------------------
# NextAuth.js Configuration
# AUTH_SECRET: Generate with `npx auth secret` or `openssl rand -base64 32`
# -----------------------------------------------------------------------------
AUTH_SECRET="your-secret-key-here-generate-with-openssl"

# -----------------------------------------------------------------------------
# Resend (Email - Magic Links & Transactional)
# Get your API key from: https://resend.com/api-keys
# Used for: Magic link authentication, application emails, booking notifications
# Free tier: 3,000 emails/month
# -----------------------------------------------------------------------------
RESEND_API_KEY="re_xxxxxxxxxxxx"

# -----------------------------------------------------------------------------
# Stripe (Payments - Membership fees)
# Get your keys from: https://dashboard.stripe.com/apikeys
# Use test keys for development, live keys for production
# Used for: $300 annual membership payments, refunds
# STRIPE_PRICE_ID: Create a product "Art Res Annual Membership" with $300 price
#                  in Stripe Dashboard, then copy the price ID (price_xxx)
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY="sk_test_xxxxxxxxxxxx"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxx"
STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxxxxxx"
STRIPE_PRICE_ID="price_xxxxxxxxxxxx"

# -----------------------------------------------------------------------------
# Cloudinary (Image Storage & CDN)
# Get your credentials from: https://cloudinary.com/console
# Used for: Profile photos, home listing photos
# Free tier: 25GB storage, 25GB bandwidth
# Note: NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME is required for client-side uploads
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="123456789012345"
CLOUDINARY_API_SECRET="your-api-secret"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"

# -----------------------------------------------------------------------------
# Pusher (Real-time Messaging)
# Get your credentials from: https://dashboard.pusher.com
# Used for: Real-time chat, booking notifications, message alerts
# Free tier: 200,000 messages/day, 100 concurrent connections
# -----------------------------------------------------------------------------
PUSHER_APP_ID="1234567"
PUSHER_KEY="xxxxxxxxxxxxxxxx"
PUSHER_SECRET="xxxxxxxxxxxxxxxx"
PUSHER_CLUSTER="us2"

# -----------------------------------------------------------------------------
# Optional: Development/Debug
# -----------------------------------------------------------------------------
# NODE_ENV="development"
# LOG_LEVEL="debug"
