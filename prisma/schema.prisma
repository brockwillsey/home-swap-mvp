// Prisma Schema for Art Res (home-swap-mvp)
// T3 Stack + NextAuth + Domain Models

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// NextAuth Models (Required for Magic Link authentication)
// =============================================================================

model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String?
  access_token             String?
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String?
  session_state            String?
  user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  refresh_token_expires_in Int?

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// =============================================================================
// Domain Models
// =============================================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  bio           String?
  location      String?
  creativeInterests String?
  role          UserRole  @default(MEMBER)
  points        Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // NextAuth relations
  accounts      Account[]
  sessions      Session[]

  // Domain relations
  homes            Home[]
  application      Application?
  reservationsAsGuest Reservation[] @relation("GuestReservations")
  sentMessages     Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")
  pointTransactions PointTransaction[]

  // Crowdfunding relations
  fundsCreated     Fund[]      @relation("FundCreator")
  donations        Donation[]  @relation("DonorDonations")
}

model Application {
  id            String            @id @default(cuid())
  userId        String            @unique
  status        ApplicationStatus @default(PENDING)
  roles         String            @default("[]") // JSON array: ARTIST, HOME_OWNER, SPONSOR
  bio           String
  location      String
  portfolioUrl  String?           // Required for artists
  studioGalleryReferral String?   // Info about nearby studios/galleries
  reasonForJoining String
  profilePhotoUrl String?
  homePhotos    String            @default("[]") // JSON array of Cloudinary URLs
  membershipFee Int               @default(0)    // Fee amount in dollars
  promoCode     String?           // Promo code used at signup
  feedback      String?           // Admin feedback for rejection
  stripePaymentId String?         // Stripe payment intent ID
  stripeSubscriptionId String?    // Stripe subscription ID
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  reviewedAt    DateTime?
  reviewedBy    String?           // Admin user ID

  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Home {
  id                    String         @id @default(cuid())
  ownerId               String
  title                 String
  description           String?
  location              String
  photos                String         @default("[]") // JSON array of Cloudinary URLs
  bookingMode           BookingMode    @default(REQUIRES_APPROVAL)
  exchangeType          ExchangeType   @default(BOTH)
  preferredDestinations String         @default("[]") // JSON array of location strings
  isActive              Boolean        @default(true)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  owner        User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  availability Availability[]
  reservations Reservation[]
  funds        Fund[]
}

model Availability {
  id        String   @id @default(cuid())
  homeId    String
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())

  home      Home     @relation(fields: [homeId], references: [id], onDelete: Cascade)

  @@index([homeId, startDate, endDate])
}

model Reservation {
  id            String            @id @default(cuid())
  guestId       String
  homeId        String
  startDate     DateTime
  endDate       DateTime
  status        ReservationStatus @default(PENDING)
  bookingType   BookingType
  pointsCost    Int?              // Points used for this booking
  swapHomeId    String?           // If swap, the guest's home being offered
  swapStartDate DateTime?         // Proposed swap dates
  swapEndDate   DateTime?
  hostMessage   String?           // Host's decline message
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  guest         User              @relation("GuestReservations", fields: [guestId], references: [id])
  home          Home              @relation(fields: [homeId], references: [id])

  @@index([guestId, status])
  @@index([homeId, status])
}

model Message {
  id          String   @id @default(cuid())
  senderId    String
  receiverId  String
  content     String
  isRead      Boolean  @default(false)
  contextType MessageContext?
  contextId   String?  // Listing ID or Reservation ID for context
  createdAt   DateTime @default(now())

  sender      User     @relation("SentMessages", fields: [senderId], references: [id])
  receiver    User     @relation("ReceivedMessages", fields: [receiverId], references: [id])

  @@index([senderId, receiverId])
  @@index([receiverId, isRead])
}

model PointTransaction {
  id          String              @id @default(cuid())
  userId      String
  amount      Int                 // Positive for earned, negative for spent
  type        PointTransactionType
  description String
  reservationId String?
  createdAt   DateTime            @default(now())

  user        User                @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

// =============================================================================
// Enums
// =============================================================================

enum UserRole {
  MEMBER
  ADMIN
}

enum ApplicationStatus {
  PENDING
  SUBMITTED    // After payment
  APPROVED
  REJECTED
  NEEDS_INFO
}

enum BookingMode {
  INSTANT_BOOK
  REQUIRES_APPROVAL
}

enum ExchangeType {
  SWAP_ONLY
  POINTS_ONLY
  BOTH
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  DECLINED
  CANCELLED
  COMPLETED
}

enum BookingType {
  POINTS
  SWAP
}

enum MessageContext {
  LISTING_INQUIRY
  BOOKING_COORDINATION
  GENERAL
}

enum PointTransactionType {
  EARNED_HOSTING
  SPENT_BOOKING
  REFUND
  INITIAL_BONUS
}

// =============================================================================
// Crowdfunding Models
// =============================================================================

model Fund {
  id              String      @id @default(cuid())
  creatorId       String
  title           String
  description     String
  goalAmount      Int         // Goal in cents
  currentAmount   Int         @default(0)
  coverImage      String?     // Cloudinary URL
  status          FundStatus  @default(DRAFT)

  homeId          String?     // Optional link to listing

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  publishedAt     DateTime?

  creator         User        @relation("FundCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  home            Home?       @relation(fields: [homeId], references: [id], onDelete: SetNull)
  donations       Donation[]

  @@index([creatorId, status])
  @@index([status, publishedAt])
}

model Donation {
  id                    String         @id @default(cuid())
  fundId                String
  donorId               String?
  amount                Int            // Amount in cents (before fees)
  platformFee           Int            // 10% fee in cents
  message               String?
  isAnonymous           Boolean        @default(false)
  stripePaymentIntentId String?        @unique
  status                DonationStatus @default(PENDING)

  createdAt             DateTime       @default(now())
  completedAt           DateTime?

  fund                  Fund           @relation(fields: [fundId], references: [id], onDelete: Cascade)
  donor                 User?          @relation("DonorDonations", fields: [donorId], references: [id], onDelete: SetNull)

  @@index([fundId, status])
  @@index([donorId])
}

enum FundStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum DonationStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}
